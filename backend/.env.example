# Salin file ini jadi .env, lalu isi sesuai environment lokal kamu.
# .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# Generate secret baru: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=ganti-dengan-secret-key-acak
DEBUG=True

DB_NAME=si_lapor_fasyankes
DB_USER=postgres
DB_PASSWORD=ganti-dengan-password-db-kamu
DB_HOST=localhost
DB_PORT=5432

# Origin frontend yang boleh akses API ini (comma-separated kalau lebih dari satu)
CORS_ALLOWED_ORIGINS="http://localhost:3000"
